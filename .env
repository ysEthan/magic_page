# # API 配置  生产环境
VITE_API_BASE_URL=/api
VITE_AUTH_BASE_URL=/auth

# Nginx 配置
NGINX_API_PROXY_PASS=http://magic_api:8002
NGINX_SERVER_PORT=80
NGINX_SERVER_NAME=localhost

# CORS 配置
NGINX_CORS_ALLOW_ORIGIN=*
NGINX_CORS_ALLOW_METHODS=GET, POST, PUT, DELETE, OPTIONS
NGINX_CORS_ALLOW_HEADERS=DNT,X-Mx-ReqToken,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Authorization 



# API 配置  测试环境
# VITE_API_BASE_URL=http://localhost:8002/
# VITE_AUTH_BASE_URL=http://localhost:8002/auth

